
FROM dunglas/frankenphp:php8.3

RUN install-php-extensions \
    pcntl \
    pdo_mysql \
    redis \
    zip

RUN apt-get update && apt-get install -y unzip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY . .

RUN COMPOSER_ALLOW_SUPERUSER=1 composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction 

CMD ["sh", "-c", "echo '=== REVERB CONTAINER STARTED ==='; php -v; echo '=== CHECKING LARAVEL ==='; php artisan --version; echo '=== STARTING REVERB ==='; exec php artisan reverb:start --host=0.0.0.0 --port=${PORT:-8080}"]
